---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <!-- En construcción: fuera de los buscadores hasta que se publique con dominio. -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main id="contenido">
      <slot />
    </main>
  </body>
</html>
