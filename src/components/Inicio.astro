---
import Base from '../layouts/Base.astro';
import { textos, rutas, type Idioma } from '../i18n/textos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];

// Un solo número, escrito siempre igual (spec, G1).
const telefono = '635 52 06 05';
const telefonoEnlace = 'tel:+34635520605';
const whatsapp = 'https://wa.me/34635520605?text=' + encodeURIComponent(t.mensajeWhatsapp);

const colores = ['naranja', 'menta', 'rosa', 'limon'];
const servicios = t.servicios.lista.map((s, i) => ({ ...s, numero: `0${i + 1}`, color: colores[i] }));

// Solo datos que Iago ha confirmado (briefing, 20/10/2026). Nada de «+200 clientes» inventados.
const cifras = [
  { cifra: 100, sufijo: '%' },
  { cifra: 1, sufijo: '' },
  { cifra: 0, sufijo: ' €' },
  { cifra: 17, sufijo: '' },
];
const datos = cifras.map((c, i) => ({ ...c, texto: t.datos[i] }));

const posiciones = [
  { color: 'naranja', x: '6%', y: '18%', giro: '-8deg' },
  { color: 'menta', x: '74%', y: '12%', giro: '6deg' },
  { color: 'rosa', x: '80%', y: '52%', giro: '-5deg' },
  { color: 'limon', x: '30%', y: '50%', giro: '9deg' },
  { color: 'blanca', x: '60%', y: '74%', giro: '-3deg' },
];
const pegatinas = posiciones.map((p, i) => ({ ...p, texto: t.pegatinas[i] }));

// Casos contados por Iago (briefing). Sin nombres, lugares, cifras ni alusiones a otras gestorías:
// así no necesitan permiso del cliente. Una cifra solo entra si es exacta y documentada (spec, 7.2).
const coloresCasos = ['rosa', 'limon', 'menta'];
const casos = t.casos.lista.map((c, i) => ({ ...c, color: coloresCasos[i] }));

const cinta = t.cinta;
const coloresPasos = ['menta', 'rosa', 'limon'];
---
<Base titulo={t.tituloPagina} descripcion={t.descripcion} idioma={idioma}>
  <header class="cabecera" slot="cabecera">
    <a class="logo" href={rutas[idioma]} aria-label={t.logoAria}>Iago<span aria-hidden="true">.</span></a>
    <p class="estado"><span class="estado__punto" aria-hidden="true"></span>{t.estado}</p>
    <nav class="nav-principal" aria-label={t.nav.aria}>
      <ul>
        <li><a href="#servicios">{t.nav.servicios}</a></li>
        <li><a href="#banco">{t.nav.banco}</a></li>
        <li><a href="#contacto">{t.nav.contacto}</a></li>
      </ul>
    </nav>
    <nav class="idiomas" aria-label={t.nav.idioma}>
      <a href={rutas.es} lang="es" hreflang="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
      <a href={rutas.ca} lang="ca" hreflang="ca" aria-current={idioma === 'ca' ? 'true' : undefined}>CA</a>
    </nav>
    <a class="boton boton--claro" href={whatsapp}>WhatsApp <span aria-hidden="true">↗</span></a>
  </header>

  <!-- PENDIENTE REVISIÓN ASESOR: todos los textos de esta página son un primer borrador. -->

  <section class="portada" aria-labelledby="titulo-portada" data-portada>
    <h1 id="titulo-portada" class="portada__nombre">
      <span class="oculto">{t.tituloOculto}</span>
      <span class="portada__letras" aria-hidden="true" data-letras>
        <span>I</span><span>A</span><span>G</span><span>O</span>
      </span>
    </h1>

    <!-- Aquí irá la foto real de Iago cuando haya sesión. Mientras, monograma y sello giratorio (nada de stock). -->
    <div class="portada__tarjeta" aria-hidden="true">
      <svg class="sello" viewBox="0 0 200 200">
        <defs><path id="circulo" d="M100,100 m-86,0 a86,86 0 1,1 172,0 a86,86 0 1,1 -172,0" /></defs>
        <text><textPath href="#circulo" textLength="536" lengthAdjust="spacing">{t.sello}</textPath></text>
      </svg>
      <span class="portada__monograma">I<span>.</span></span>
    </div>

    <div class="portada__pie">
      <div>
        <p class="portada__rol" set:html={t.rol} />
        <p class="portada__texto">{t.portadaTexto}</p>
        <div class="acciones">
          <a class="boton" href={whatsapp} data-iman>{t.escribeme} <span aria-hidden="true">↗</span></a>
          <a class="enlace-telefono" href={telefonoEnlace}>{telefono}</a>
        </div>
      </div>
      <ul class="portada__enlaces">
        <li><a href={whatsapp}>WhatsApp</a></li>
        <li><a href={telefonoEnlace}>{t.llamar}</a></li>
        <li><a href="#servicios">{t.nav.servicios}</a></li>
      </ul>
    </div>

    {pegatinas.map((p) => (
      <span
        class={`pegatina pegatina--${p.color}`}
        style={`--x:${p.x};--y:${p.y};--giro:${p.giro}`}
        aria-hidden="true"
        data-pegatina
      >{p.texto}</span>
    ))}
    <p class="portada__pista" aria-hidden="true">{t.pista}</p>
  </section>

  <div class="cinta" aria-hidden="true">
    <div class="cinta__pista">
      {[0, 1].map(() => (
        <span class="cinta__grupo">
          {cinta.map((c, i) => (
            <span class={i % 2 ? 'cursiva' : ''}>{c} <b>✳</b></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <section class="datos envoltura" aria-label={t.datosAria}>
    <ul>
      {datos.map((d, i) => (
        <li data-aparecer style={`--retraso:${i * 0.08}s`}>
          <span class="datos__cifra"><span data-contar={d.cifra}>{d.cifra}</span>{d.sufijo}</span>
          <span class="datos__texto">{d.texto}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="servicios" class="servicios envoltura" aria-labelledby="titulo-servicios">
    <div class="encabezado" data-aparecer>
      <p class="etiqueta">{t.servicios.etiqueta}</p>
      <h2 id="titulo-servicios" set:html={t.servicios.titulo} />
    </div>
    <ul class="servicios__lista">
      {servicios.map((s, i) => (
        <li data-aparecer style={`--retraso:${i * 0.06}s`}>
          <details class="servicio" name="servicios">
            <summary>
              <span class="servicio__numero">{s.numero}</span>
              <span class="servicio__titulo">{s.titulo}</span>
              <span class={`servicio__etiqueta pegatina--${s.color}`}>{s.etiqueta}</span>
              <span class="servicio__mas" aria-hidden="true"></span>
            </summary>
            <div class="servicio__cuerpo">
              <p>{s.texto}</p>
              <a href={whatsapp}>{t.servicios.pregunta} <span aria-hidden="true">↗</span></a>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </section>

  <section id="banco" class="banco" aria-labelledby="titulo-banco" data-luz>
    <div class="banco__luz" aria-hidden="true"></div>
    <div class="envoltura banco__dentro">
      <div class="encabezado" data-aparecer>
        <p class="etiqueta">{t.banco.etiqueta}</p>
        <h2 id="titulo-banco" set:html={t.banco.titulo} />
      </div>
      <!-- PENDIENTE REVISIÓN ASESOR · PENDIENTE VALIDACIÓN LEGAL: no publicar sin que lo revise un abogado
           (ver docs/briefing.md, «Notas para la especificación», punto 1). -->
      <div class="banco__columnas">
        <div data-aparecer>
          <p class="banco__entradilla">{t.banco.entradilla}</p>
          <ul class="banco__productos">
            {t.banco.productos.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="banco__aviso" data-aparecer style="--retraso:0.1s">
          <p class="banco__grande" set:html={t.banco.grande} />
          <p class="banco__letra">{t.banco.letra}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="casos envoltura" aria-labelledby="titulo-casos">
    <div class="encabezado" data-aparecer>
      <p class="etiqueta">{t.casos.etiqueta}</p>
      <h2 id="titulo-casos" set:html={t.casos.titulo} />
    </div>
    <!-- PENDIENTE REVISIÓN ASESOR: casos contados por Iago, sin datos que identifiquen a nadie. -->
    <ul class="casos__lista">
      {casos.map((c, i) => (
        <li class="caso" data-aparecer data-inclinar style={`--retraso:${i * 0.1}s`}>
          <span class={`caso__tema pegatina--${c.color}`}>{c.tema}</span>
          <p class="caso__texto">{c.texto}</p>
          <span class="caso__numero" aria-hidden="true">0{i + 1}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="pasos envoltura" aria-labelledby="titulo-pasos">
    <div class="encabezado" data-aparecer>
      <p class="etiqueta">{t.pasos.etiqueta}</p>
      <h2 id="titulo-pasos" set:html={t.pasos.titulo} />
    </div>
    <ol class="pasos__lista">
      {t.pasos.lista.map((p, i) => (
        <li class={`paso paso--${coloresPasos[i]}`}>
          <span class="paso__numero">0{i + 1}</span>
          <p class="paso__titulo">{p.titulo}</p>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="contacto" class="contacto envoltura" aria-labelledby="titulo-contacto">
    <p class="etiqueta" data-aparecer>{t.contacto.etiqueta}</p>
    <h2 id="titulo-contacto" class="contacto__titulo" data-aparecer set:html={t.contacto.titulo} />
    <div class="contacto__fila" data-aparecer>
      <p class="contacto__texto">{t.contacto.texto}</p>
      <a class="contacto__circulo" href={whatsapp} data-iman>
        <span set:html={t.contacto.circulo} />
      </a>
      <a class="enlace-telefono enlace-telefono--grande" href={telefonoEnlace}>{telefono}</a>
    </div>
    <!-- El formulario por email se añade cuando Iago confirme a qué dirección llegan los mensajes (spec, G3). -->
  </section>

  <footer class="pie" slot="pie">
    <div class="envoltura pie__arriba">
      <p>{t.pie.rol}</p>
      <p>{t.pie.legal}</p>
    </div>
    <p class="pie__nombre" aria-hidden="true">IAGO<span>.</span></p>
  </footer>

  <a class="barra-movil" href={whatsapp}>{t.barraMovil} <span aria-hidden="true">↗</span></a>
</Base>

<script>
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const punteroFino = matchMedia('(pointer: fine)').matches;

  // Aparición al hacer scroll.
  const observador = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('visible');
        observador.unobserve(e.target);
      }
    },
    { threshold: 0.15 },
  );
  document.querySelectorAll('[data-aparecer]').forEach((el) => observador.observe(el));

  // Cifras que cuentan hasta su valor al aparecer.
  const contador = new IntersectionObserver((entradas) => {
    for (const e of entradas) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      contador.unobserve(el);
      const final = Number(el.dataset.contar);
      if (sinMovimiento || final === 0) continue;
      const inicio = performance.now();
      const paso = (t: number) => {
        const p = Math.min((t - inicio) / 1200, 1);
        el.textContent = String(Math.round(final * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(paso);
      };
      el.textContent = '0';
      requestAnimationFrame(paso);
    }
  }, { threshold: 0.6 });
  document.querySelectorAll('[data-contar]').forEach((el) => contador.observe(el));

  // Letras del nombre: se ensanchan y engordan cerca del cursor (ejes variables de Archivo).
  const letras = document.querySelector('[data-letras]');
  const portada = document.querySelector<HTMLElement>('[data-portada]');
  if (letras && portada && punteroFino && !sinMovimiento) {
    const spans = [...letras.children] as HTMLElement[];
    let pendiente = false;
    let x = 0;
    portada.addEventListener('pointermove', (ev) => {
      x = ev.clientX;
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        for (const s of spans) {
          const r = s.getBoundingClientRect();
          const d = Math.min(Math.abs(x - (r.left + r.width / 2)) / innerWidth, 0.5) * 2; // 0 cerca, 1 lejos
          s.style.fontVariationSettings = `"wdth" ${125 - d * 45}, "wght" ${900 - d * 350}`;
        }
      });
    });
    portada.addEventListener('pointerleave', () => spans.forEach((s) => (s.style.fontVariationSettings = '')));
  }

  // Pegatinas arrastrables.
  document.querySelectorAll<HTMLElement>('[data-pegatina]').forEach((p) => {
    let dx = 0, dy = 0, ox = 0, oy = 0;
    p.addEventListener('pointerdown', (ev) => {
      p.setPointerCapture(ev.pointerId);
      ox = ev.clientX - dx;
      oy = ev.clientY - dy;
      p.classList.add('arrastrando');
    });
    p.addEventListener('pointermove', (ev) => {
      if (!p.hasPointerCapture(ev.pointerId)) return;
      dx = ev.clientX - ox;
      dy = ev.clientY - oy;
      p.style.translate = `${dx}px ${dy}px`;
    });
    const soltar = () => p.classList.remove('arrastrando');
    p.addEventListener('pointerup', soltar);
    p.addEventListener('pointercancel', soltar);
  });

  // Botones «imán»: siguen un poco al cursor.
  if (punteroFino && !sinMovimiento) {
    document.querySelectorAll<HTMLElement>('[data-iman]').forEach((b) => {
      b.addEventListener('pointermove', (ev) => {
        const r = b.getBoundingClientRect();
        b.style.translate = `${(ev.clientX - r.left - r.width / 2) * 0.25}px ${(ev.clientY - r.top - r.height / 2) * 0.25}px`;
      });
      b.addEventListener('pointerleave', () => (b.style.translate = ''));
    });
  }

  // Tarjetas de casos: se inclinan un poco hacia el cursor.
  if (punteroFino && !sinMovimiento) {
    document.querySelectorAll<HTMLElement>('[data-inclinar]').forEach((t) => {
      t.addEventListener('pointermove', (ev) => {
        const r = t.getBoundingClientRect();
        const px = (ev.clientX - r.left) / r.width - 0.5;
        const py = (ev.clientY - r.top) / r.height - 0.5;
        t.style.transform = `perspective(900px) rotateX(${py * -6}deg) rotateY(${px * 6}deg)`;
      });
      t.addEventListener('pointerleave', () => (t.style.transform = ''));
    });
  }

  // Luz que sigue al cursor en el bloque del banco.
  const luz = document.querySelector<HTMLElement>('[data-luz]');
  if (luz && punteroFino && !sinMovimiento) {
    luz.addEventListener('pointermove', (ev) => {
      const r = luz.getBoundingClientRect();
      luz.style.setProperty('--lx', `${ev.clientX - r.left}px`);
      luz.style.setProperty('--ly', `${ev.clientY - r.top}px`);
    });
  }
</script>

<style>
  .envoltura { max-width: 90rem; margin-inline: auto; padding-inline: var(--margen-lateral); }
  .oculto {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  /* ───── Cabecera en píldora flotante ───── */
  .cabecera {
    position: sticky; top: 0.75rem; z-index: 20;
    display: flex; align-items: center; gap: 1.5rem;
    width: min(90rem - 2 * var(--margen-lateral), calc(100% - 2 * var(--margen-lateral)));
    margin: 0.75rem auto 0;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    background: rgb(245 241 232 / 0.75);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgb(19 19 19 / 0.08);
    border-radius: 999px;
  }
  /* Selector de idioma: dos pastillas, la activa en negro. */
  .idiomas { display: flex; gap: 2px; padding: 3px; border-radius: 999px; background: rgb(19 19 19 / 0.07); }
  .idiomas a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 48px; min-height: 42px; padding: 0 0.75rem; border-radius: 999px;
    font-size: var(--texto-pequeno); font-weight: 700; letter-spacing: 0.04em; text-decoration: none;
    color: var(--color-tinta-suave);
    transition: background-color 0.25s var(--curva), color 0.25s var(--curva);
  }
  .idiomas a:hover { color: var(--color-tinta); }
  .idiomas a[aria-current] { background: var(--color-tinta); color: var(--color-crema-claro); }

  .logo { font-weight: 800; font-size: 1.375rem; text-decoration: none; letter-spacing: -0.04em; }
  .logo span { color: var(--color-naranja); }
  .estado { display: flex; align-items: center; gap: 0.5rem; font-size: var(--texto-pequeno); color: var(--color-tinta-suave); }
  .estado__punto {
    width: 8px; height: 8px; border-radius: 50%; background: var(--color-verde-vivo);
    box-shadow: 0 0 0 0 rgb(43 212 122 / 0.6);
    animation: latir 2s infinite;
  }
  @keyframes latir { 70% { box-shadow: 0 0 0 8px rgb(43 212 122 / 0); } 100% { box-shadow: 0 0 0 0 rgb(43 212 122 / 0); } }
  .nav-principal { margin-left: auto; }
  .cabecera ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-principal a {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 1rem;
    border-radius: 999px; text-decoration: none; font-size: var(--texto-pequeno); font-weight: 500;
    transition: background-color 0.25s var(--curva);
  }
  .nav-principal a:hover { background: rgb(19 19 19 / 0.06); }
  @media (max-width: 47.99rem) {
    .nav-principal, .estado { display: none; }
    .idiomas { margin-left: auto; }
  }

  .boton {
    display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center;
    min-height: 48px; padding: 0 1.5rem;
    background: var(--color-tinta); color: var(--color-crema-claro);
    font-weight: 600; font-size: var(--texto-pequeno); text-decoration: none;
    border-radius: 999px;
    transition: translate 0.3s var(--curva), background-color 0.25s var(--curva);
  }
  .boton:hover { background: #000; }
  .boton span { transition: transform 0.3s var(--curva); }
  .boton:hover span { transform: translate(2px, -2px); }

  .enlace-telefono {
    display: inline-flex; align-items: center; min-height: 48px;
    font-variant-numeric: tabular-nums; font-weight: 600; letter-spacing: 0.01em;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em;
    text-decoration-color: rgb(19 19 19 / 0.25);
    transition: text-decoration-color 0.25s var(--curva);
  }
  .enlace-telefono:hover { text-decoration-color: var(--color-naranja); }

  /* ───── Portada ───── */
  .portada {
    position: relative;
    max-width: 90rem; margin-inline: auto;
    padding: clamp(2rem, 6vw, 4rem) var(--margen-lateral) clamp(2rem, 5vw, 3.5rem);
    min-height: min(calc(100svh - 5rem), 62rem);
    overflow: clip;
    display: grid; grid-template-rows: auto 1fr auto;
  }
  .portada__nombre {
    position: relative; z-index: 2; pointer-events: none;
    /* Color crema + «difference»: negro sobre el fondo crema, claro sobre la tarjeta oscura. */
    color: var(--color-crema);
    mix-blend-mode: difference;
  }
  .portada__letras {
    display: flex; justify-content: center;
    font-size: min(27vw, 26rem, 42svh);
    font-weight: 800; font-variation-settings: "wdth" 125, "wght" 800;
    line-height: 0.8; letter-spacing: -0.04em;
  }
  .portada__letras span {
    display: inline-block;
    transition: font-variation-settings 0.5s var(--curva);
    animation: subir 1s var(--curva) both;
  }
  .portada__letras span:nth-child(2) { animation-delay: 0.06s; }
  .portada__letras span:nth-child(3) { animation-delay: 0.12s; }
  .portada__letras span:nth-child(4) { animation-delay: 0.18s; }
  @keyframes subir { from { opacity: 0; transform: translateY(18%); } }

  .portada__tarjeta {
    position: absolute; z-index: 1;
    left: 50%; top: clamp(8rem, min(17vw, 22svh), 15rem);
    width: clamp(11rem, min(20vw, 30svh), 19rem); aspect-ratio: 4 / 5;
    translate: -50% 0;
    border-radius: var(--radio);
    background:
      radial-gradient(120% 80% at 30% 20%, #2a2b2d 0%, var(--color-noche) 60%);
    box-shadow: 0 30px 60px -20px rgb(19 19 19 / 0.45);
    display: grid; place-items: center;
    overflow: hidden;
    animation: tarjeta 1.1s 0.2s var(--curva) both;
  }
  @keyframes tarjeta { from { opacity: 0; transform: translateY(40px) rotate(-4deg); } }
  /* En portátil y escritorio la tarjeta baja a la franja inferior, entre el texto y los enlaces,
     para no tapar el nombre (en móvil sí queda bien superpuesta). */
  @media (min-width: 48rem) {
    .portada__tarjeta {
      top: auto; bottom: clamp(2rem, 5vw, 3.5rem);
      width: auto; height: clamp(12rem, 28svh, 17rem);
    }
    .portada__tarjeta .portada__monograma { font-size: clamp(3.5rem, 9svh, 6rem); }
  }
  .portada__monograma {
    font-size: clamp(4rem, 9vw, 8rem); font-weight: 800; color: var(--color-crema-claro);
    letter-spacing: -0.05em; line-height: 1;
  }
  .portada__monograma span { color: var(--color-naranja); }
  .sello {
    position: absolute; width: 100%; fill: var(--color-noche-texto);
    font-size: 13.5px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 500;
    animation: girar 22s linear infinite;
  }
  @keyframes girar { to { transform: rotate(360deg); } }

  .portada__pie {
    position: relative; z-index: 3; grid-row: 3;
    display: flex; justify-content: space-between; align-items: end; gap: 2rem;
    animation: subir 1s 0.35s var(--curva) both;
